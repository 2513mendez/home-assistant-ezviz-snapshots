{
  "name": "EZVIZ Snapshots API/MQTT (Multi-account)",
  "version": "1.4.0",
  "slug": "ezviz_snapshots_core",
  "description": "Snapshots de EZVIZ por MQTT con MQTT Discovery (entidades image.* automáticas en HA), modo servicio con intervalo o una pasada, multi-cuenta con token cacheado por cuenta.",
  "arch": [
    "armv7",
    "armhf",
    "aarch64",
    "amd64",
    "i386"
  ],
  "startup": "application",
  "boot": "auto",
  "services": [
    "mqtt:want"
  ],
  "options": {
    "interval_minutes": 5,
    "mqtt_source": "auto",
    "retain": true,
    "quality": 0,
    "debug": false,
    "discovery": true,
    "discovery_prefix": "homeassistant",
    "image_mode": "url",
    "save_to_www": false,
    "save_dir": "/homeassistant/www/ezviz",
    "mqtt_host": "core-mosquitto",
    "mqtt_port": 1883,
    "mqtt_user": "",
    "mqtt_password": "",
    "account1_id": "",
    "account1_app_key": "",
    "account1_app_secret": "",
    "account2_id": "",
    "account2_app_key": "",
    "account2_app_secret": "",
    "accounts": [],
    "camaras": []
  },
  "schema": {
    "interval_minutes": "int?",
    "mqtt_source": "list(auto|manual)?",
    "retain": "bool",
    "quality": "int?",
    "debug": "bool?",
    "discovery": "bool?",
    "discovery_prefix": "str?",
    "image_mode": "list(url|download)?",
    "save_to_www": "bool?",
    "save_dir": "str?",
    "mqtt_host": "str",
    "mqtt_port": "int",
    "mqtt_user": "str",
    "mqtt_password": "password",
    "account1_id": "str?",
    "account1_app_key": "str?",
    "account1_app_secret": "password?",
    "account2_id": "str?",
    "account2_app_key": "str?",
    "account2_app_secret": "password?",
    "accounts": [
      {
        "id": "str",
        "app_key": "str",
        "app_secret": "password",
        "quality": "int?"
      }
    ],
    "camaras": [
      {
        "nombre": "str",
        "serial": "str",
        "channel": "int",
        "quality": "int?",
        "account": "str"
      }
    ]
  },
  "init": false,
  "host_network": false,
  "privileged": [],
  "apparmor": false,
  "map": [
    "homeassistant_config:rw"
  ]
}